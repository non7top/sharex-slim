<Project>
  <PropertyGroup>
    <Company>ShareX Team</Company>
    <Product>ShareX-slim</Product>
    <Copyright>Copyright (c) 2007-2026 ShareX Team</Copyright>
    <!-- ShareX-slim's own version. Forked from upstream ShareX 21.0.0. -->
    <Version>1.0.0</Version>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <!-- Lets the Windows-targeted projects compile on non-Windows hosts (CI/containers). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Configurations>Release;Debug</Configurations>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>
</Project>
